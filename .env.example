# ===========================================
# chen-ai-agent 环境变量模板
# 复制此文件为 .env 后，填入真实值
# .env 已在 .gitignore 中，不会提交到 GitHub
# ===========================================

# ---------- 必填 ----------
AI_DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- Docker 生产基础设施 ----------
POSTGRES_PASSWORD=change_me_to_a_strong_password
SPRING_PROFILES_ACTIVE=local

# ---------- ChenManus Runtime ----------
CHENMANUS_REDIS_ENABLED=true
CHENMANUS_MAX_PARALLEL_STEPS=4
CHENMANUS_MAX_ACTIVE_TASKS_PER_TENANT=20
CHENMANUS_ARTIFACT_ALLOWED_ROOT=./data

# ---------- OAuth2 / OIDC（生产建议） ----------
# 设置 SPRING_PROFILES_ACTIVE=oauth2 后启用 JWT Resource Server
OAUTH2_ISSUER_URI=https://your-issuer.example.com/realms/your-tenant
OAUTH2_AUDIENCE=

# ---------- 可信身份网关模式（legacy 模式可选） ----------
# legacy 模式下由 body/query 提供 tenantId/userId；
# 接入可信网关后可改为 true/true，由 X-Tenant-Id / X-User-Id 提供身份。
CHENMANUS_SECURITY_TRUST_IDENTITY_HEADERS=false
CHENMANUS_SECURITY_REQUIRE_IDENTITY_HEADERS=false

# ---------- 成本估算 ----------
# 货币单位由部署方自行定义；0 表示不估算成本
CHENMANUS_INPUT_COST_PER_1K=0.0
CHENMANUS_OUTPUT_COST_PER_1K=0.0

# ---------- 可选 ----------
API_KEY=
SEARCH_API_KEY=
