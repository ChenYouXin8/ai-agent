# ===========================================
# chen-ai-agent 环境变量模板
# 复制此文件为 .env 后，填入真实值
# .env 已在 .gitignore 中，不会提交到 GitHub
# ===========================================

# ---------- 必填 ----------
# 通义千问 API Key
AI_DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------- 生产基础设施（Docker 推荐） ----------
# docker compose 会默认使用 PostgreSQL + Redis
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ---------- ChenManus Runtime ----------
# 单实例可并行执行的 Step 上限
CHENMANUS_MAX_PARALLEL_STEPS=4
# 单租户进行中的任务上限；0 表示不限制
CHENMANUS_MAX_ACTIVE_TASKS_PER_TENANT=20
# Artifact 可下载/预览的安全根目录
CHENMANUS_ARTIFACT_ALLOWED_ROOT=./data

# ---------- 可信身份 ----------
# 开发模式保持 false：允许 body/query 传入 tenantId/userId
# 生产环境建议由认证网关注入 X-Tenant-Id / X-User-Id 后打开
CHENMANUS_TRUST_IDENTITY_HEADERS=false
CHENMANUS_REQUIRE_IDENTITY_HEADERS=false

# ---------- 可选 ----------
# 生产环境 Bearer Token 鉴权
# API_KEY=your_random_secret_token_here

# searchapi.io Key（未设置则 WebSearch 工具不可用）
# SEARCH_API_KEY=your_searchapi_key_here

# Redis 任务队列：本地开发保持 false，Docker Compose 会覆盖为 true
# CHENMANUS_REDIS_ENABLED=false

# 成本口径（货币单位由部署方自行定义；0 表示不估算成本）
# CHENMANUS_INPUT_COST_PER_1K=0.0
# CHENMANUS_OUTPUT_COST_PER_1K=0.0
