{
  "mcpServers": {
    "amap-maps": {
      "command": "npx",
      "args": [
        "-y",
        "@amap/amap-maps-mcp-server"
      ],
      "env": {
        "AMAP_MAPS_API_KEY": "在此填写你的高德Key"
      }
    },
    "chen-image-search-mcp-server": {
      "command": "java",
      "args": [
        "-Dspring.ai.mcp.server.stdio=true",
        "-Dspring.main.web-application-type=none",
        "-Dlogging.pattern.console=",
        "-jar",
        "chen-image-serach-mvp-sever/target/chen-image-serach-mvp-sever-0.0.1-SNAPSHOT.jar"
      ],
      "env": {}
    }
  }
}
